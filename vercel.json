{
  "version": 2,
  "builds": [
    {
      "src": "booking-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/booking-app/dist/assets/$1"
    },
    {
      "src": "/vite.svg",
      "dest": "/booking-app/dist/vite.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/booking-app/dist/index.html"
    }
  ]
}
