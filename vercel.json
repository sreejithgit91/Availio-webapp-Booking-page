{
  "buildCommand": "cd booking-app && npm install && npm run build",
  "outputDirectory": "booking-app/dist",
  "installCommand": "cd booking-app && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/vite.svg",
      "destination": "/vite.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
